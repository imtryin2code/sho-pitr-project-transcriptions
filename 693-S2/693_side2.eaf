        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a201"
                TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts59">
                <ANNOTATION_VALUE>JM: he looked back and the boy was there again</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a202"

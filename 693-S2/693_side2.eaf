                <ANNOTATION_VALUE>JP: pi wəx̣t q'uʔ &lt;wəx̣t&gt; kʰupa ixt tənəs-ɬush-iliʔi wəx̣t kʰupa paya</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>

            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a445"
                TIME_SLOT_REF1="ts267" TIME_SLOT_REF2="ts269">
                <ANNOTATION_VALUE>JM:  then his son-in-law went and caught two bears</ANNOTATION_VALUE>

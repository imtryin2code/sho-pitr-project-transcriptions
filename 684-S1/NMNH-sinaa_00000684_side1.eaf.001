        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a414"
                TIME_SLOT_REF1="ts143" TIME_SLOT_REF2="ts145">
                <ANNOTATION_VALUE>JM:  then the young man took some water</ANNOTATION_VALUE>

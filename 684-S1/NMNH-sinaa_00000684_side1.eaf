            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a540"
                TIME_SLOT_REF1="ts647" TIME_SLOT_REF2="ts649">
                <ANNOTATION_VALUE>JM:  after a looong time he reached the country of the supernatural people</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a541"
                TIME_SLOT_REF1="ts651" TIME_SLOT_REF2="ts653">
                <ANNOTATION_VALUE>JM:  they were shooting at the targets</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a542"
                TIME_SLOT_REF1="ts655" TIME_SLOT_REF2="ts657">
                <ANNOTATION_VALUE>JM:  he was afraid</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a543"
                TIME_SLOT_REF1="ts659" TIME_SLOT_REF2="ts661">
                <ANNOTATION_VALUE>JM:  but when it was dark</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a544"
                TIME_SLOT_REF1="ts663" TIME_SLOT_REF2="ts665">
                <ANNOTATION_VALUE>JM:  he took the targets and ran away</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a545"
                TIME_SLOT_REF1="ts667" TIME_SLOT_REF2="ts669">
                <ANNOTATION_VALUE>JM:  they were shooting at the targets</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a546"
                TIME_SLOT_REF1="ts671" TIME_SLOT_REF2="ts673">
                <ANNOTATION_VALUE>JM:  but he ran away with &lt;him/it&gt;</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a547"
                TIME_SLOT_REF1="ts675" TIME_SLOT_REF2="ts677">
                <ANNOTATION_VALUE>JM:  the supernatural people lit their torches and chased him</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a548"
                TIME_SLOT_REF1="ts679" TIME_SLOT_REF2="ts681">
                <ANNOTATION_VALUE>JM:  he came running</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a549"
                TIME_SLOT_REF1="ts683" TIME_SLOT_REF2="ts685">
                <ANNOTATION_VALUE>JM:  he was pursued</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a550"
                TIME_SLOT_REF1="ts687" TIME_SLOT_REF2="ts689">
                <ANNOTATION_VALUE>JM:  after some time</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a551"
                TIME_SLOT_REF1="ts691" TIME_SLOT_REF2="ts693">
                <ANNOTATION_VALUE>JM:  his wife thought of him</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a552"
                TIME_SLOT_REF1="ts695" TIME_SLOT_REF2="ts697">
                <ANNOTATION_VALUE>JM:  and told her children</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a553"
                TIME_SLOT_REF1="ts699" TIME_SLOT_REF2="ts701">
                <ANNOTATION_VALUE>JM:  now whip your grandfather</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a554"
                TIME_SLOT_REF1="ts703" TIME_SLOT_REF2="ts705">
                <ANNOTATION_VALUE>JM:  they took a stick and whipped him</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a555"
                TIME_SLOT_REF1="ts707" TIME_SLOT_REF2="ts709">
                <ANNOTATION_VALUE>JM:  their mother helped them</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a556"
                TIME_SLOT_REF1="ts711" TIME_SLOT_REF2="ts713">
                <ANNOTATION_VALUE>JM:  the old man urinated</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a557"
                TIME_SLOT_REF1="ts715" TIME_SLOT_REF2="ts717">
                <ANNOTATION_VALUE>JM:  it began to rain</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a558"
                TIME_SLOT_REF1="ts719" TIME_SLOT_REF2="ts721">
                <ANNOTATION_VALUE>JM:  and this put out the torches of the supernatural people</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>

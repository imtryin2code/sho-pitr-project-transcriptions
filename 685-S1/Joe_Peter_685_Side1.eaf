        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a486"
                TIME_SLOT_REF1="ts501" TIME_SLOT_REF2="ts503">
                <ANNOTATION_VALUE>JM:  I went across</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a487"
                TIME_SLOT_REF1="ts505" TIME_SLOT_REF2="ts507">
                <ANNOTATION_VALUE>JM:  and found their bodies</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a488"
                TIME_SLOT_REF1="ts509" TIME_SLOT_REF2="ts511">
                <ANNOTATION_VALUE>JM:  full of birds which ate them</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a489"
                TIME_SLOT_REF1="ts513" TIME_SLOT_REF2="ts515">
                <ANNOTATION_VALUE>JM:  all kinds of birds ate them</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a490"
                TIME_SLOT_REF1="ts517" TIME_SLOT_REF2="ts519">
                <ANNOTATION_VALUE>JM:  after she had finished</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a491"
                TIME_SLOT_REF1="ts521" TIME_SLOT_REF2="ts523">
                <ANNOTATION_VALUE>JM:  the bird was the first to leave the house</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a492"
                TIME_SLOT_REF1="ts525" TIME_SLOT_REF2="ts527">
                <ANNOTATION_VALUE>JM:  he went to the rear of the house where he stayed</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a493"
                TIME_SLOT_REF1="ts529" TIME_SLOT_REF2="ts531">
                <ANNOTATION_VALUE>JM:  now the crow was silent</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a494"
                TIME_SLOT_REF1="ts533" TIME_SLOT_REF2="ts535">
                <ANNOTATION_VALUE>JM:  robin, who was her deceased/ husband's brother, remained with her.  robin was her dead brother's husband, stayed with her</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a495"
                TIME_SLOT_REF1="ts537" TIME_SLOT_REF2="ts539">
                <ANNOTATION_VALUE>JM:  they sat on opposite sides of the fire</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a496"
                TIME_SLOT_REF1="ts541" TIME_SLOT_REF2="ts543">
                <ANNOTATION_VALUE>JM:  she had five children</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a497"
                TIME_SLOT_REF1="ts545" TIME_SLOT_REF2="ts547">
                <ANNOTATION_VALUE>JM:  then she told him everything in a low voice</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a498"
                TIME_SLOT_REF1="ts549" TIME_SLOT_REF2="ts551">
                <ANNOTATION_VALUE>JM:  and bluejay listened outside</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a499"
                TIME_SLOT_REF1="ts553" TIME_SLOT_REF2="ts555">
                <ANNOTATION_VALUE>JM:  she pulled out the food which she had carried home</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a500"
                TIME_SLOT_REF1="ts557" TIME_SLOT_REF2="ts559">
                <ANNOTATION_VALUE>JM:  and gave it to her children and to the robin</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a517"
                TIME_SLOT_REF1="ts560" TIME_SLOT_REF2="ts563">
                <ANNOTATION_VALUE>JM:  her youngest daughter</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a501"
                TIME_SLOT_REF1="ts564" TIME_SLOT_REF2="ts567">
                <ANNOTATION_VALUE>JM:  her youngest daughter choked while eating the blubber</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a502"
                TIME_SLOT_REF1="ts569" TIME_SLOT_REF2="ts571">
                <ANNOTATION_VALUE>JM:  then the bird</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a503"
                TIME_SLOT_REF1="ts573" TIME_SLOT_REF2="ts575">
                <ANNOTATION_VALUE>JM:  who had been peeking through the chinks in the wall</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a504"
                TIME_SLOT_REF1="ts577" TIME_SLOT_REF2="ts579">
                <ANNOTATION_VALUE>JM:  appeared and slapped her stomach</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a505"
                TIME_SLOT_REF1="ts581" TIME_SLOT_REF2="ts583">
                <ANNOTATION_VALUE>JM:  the piece of whale meat flew out of her mouth</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a506"
                TIME_SLOT_REF1="ts585" TIME_SLOT_REF2="ts587">
                <ANNOTATION_VALUE>JM:  the bird took it and showed it to the people in the village</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a507"
                TIME_SLOT_REF1="ts589" TIME_SLOT_REF2="ts591">
                <ANNOTATION_VALUE>JM:  he said</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a508"
                TIME_SLOT_REF1="ts593" TIME_SLOT_REF2="ts595">
                <ANNOTATION_VALUE>JM:  do you see?</ANNOTATION_VALUE>

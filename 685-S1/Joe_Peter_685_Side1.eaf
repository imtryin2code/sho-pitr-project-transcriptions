        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a509"
                TIME_SLOT_REF1="ts597" TIME_SLOT_REF2="ts599">
                <ANNOTATION_VALUE>JM:  the crow fed me</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a510"
                TIME_SLOT_REF1="ts601" TIME_SLOT_REF2="ts603">
                <ANNOTATION_VALUE>JM:  he went to three houses showing it around</ANNOTATION_VALUE>

        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a512"
                TIME_SLOT_REF1="ts609" TIME_SLOT_REF2="ts611">
                <ANNOTATION_VALUE>JM:  the people were very angry [note: JM misreads "hungry" as "angry" and JP translates "angry"]</ANNOTATION_VALUE>

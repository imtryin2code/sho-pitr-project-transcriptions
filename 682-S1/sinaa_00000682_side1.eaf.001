        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1001"
                TIME_SLOT_REF1="ts531" TIME_SLOT_REF2="ts533">
                <ANNOTATION_VALUE>JM:  somebody arrived at our house</ANNOTATION_VALUE>

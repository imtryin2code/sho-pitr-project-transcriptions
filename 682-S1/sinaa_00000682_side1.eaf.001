        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a999"
                TIME_SLOT_REF1="ts527" TIME_SLOT_REF2="ts529">
                <ANNOTATION_VALUE>JM:  come let us go home</ANNOTATION_VALUE>

        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1017"
                TIME_SLOT_REF1="ts563" TIME_SLOT_REF2="ts565">
                <ANNOTATION_VALUE>JM:  then the girl grew angry</ANNOTATION_VALUE>
